# ==============================================================================
# Credenciais do Projeto Firebase (Cloud Firestore)
# Copie este arquivo para `apps/mobile/.env` e preencha os valores obtidos em:
# Console do Firebase -> Configurações do Projeto -> Geral -> Seus aplicativos (Web)
# ==============================================================================

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: debug, info, warn, error. Default: debug in dev, info in production.
# VITE_LOG_LEVEL=info
