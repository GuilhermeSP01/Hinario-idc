{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Hymn",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "number",
    "title",
    "sections",
    "version"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{3,}$"
    },
    "number": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "sections": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HymnSection"
      }
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "deleted": {
      "type": "boolean"
    }
  },
  "$defs": {
    "SectionType": {
      "type": "string",
      "enum": [
        "verse",
        "chorus"
      ]
    },
    "HymnSection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "lines"
      ],
      "properties": {
        "type": {
          "$ref": "#/$defs/SectionType"
        },
        "number": {
          "type": "integer",
          "minimum": 1
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "HinarioMetadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "currentVersion",
        "updatedAt"
      ],
      "properties": {
        "currentVersion": {
          "type": "integer",
          "minimum": 1
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "totalHymns": {
          "type": "integer",
          "minimum": 1
        },
        "releaseHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
