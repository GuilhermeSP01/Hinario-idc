rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Metadados de versão global do hinário (ex: metadata/version)
    match /metadata/{docId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }

    // Coleção principal de hinos (sincronização delta via campo 'version')
    match /hymns/{hymnId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.admin == true;
    }
  }
}
