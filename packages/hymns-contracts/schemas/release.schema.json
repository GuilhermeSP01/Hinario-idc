{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "HymnRelease",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "version",
    "updatedAt",
    "totalHymns",
    "hymns"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "totalHymns": {
      "type": "integer",
      "minimum": 1
    },
    "hymns": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "hymn.schema.json"
      }
    }
  }
}
