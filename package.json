{
  "name": "hinario-idc",
  "version": "0.1.0",
  "private": true,
  "description": "Ecossistema Hinário IDC — Monorepo (App Mobile Capacitor, Domínio Compartilhado, Firestore Sync e Ferramentas)",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "dev": "corepack pnpm --filter @hinario/mobile dev",
    "build": "corepack pnpm --filter @hinario/mobile build",
    "preview": "corepack pnpm --filter @hinario/mobile preview",
    "typecheck": "corepack pnpm -r run typecheck",
    "cap:sync": "corepack pnpm --filter @hinario/mobile cap:sync",
    "cap:android": "corepack pnpm --filter @hinario/mobile cap:android",
    "cap:ios": "corepack pnpm --filter @hinario/mobile cap:ios",
    "deploy": "corepack pnpm build && firebase deploy --only firestore,hosting",
    "deploy:hosting": "corepack pnpm build && firebase deploy --only hosting",
    "deploy:rules": "firebase deploy --only firestore",
    "hymns:ingest": "python apps/hymns-pipeline/run.py ingest",
    "hymns:transform": "python apps/hymns-pipeline/run.py transform",
    "hymns:release": "python apps/hymns-pipeline/run.py release",
    "hymns:validate": "python apps/hymns-pipeline/run.py validate",
    "hymns:seed": "python apps/hymns-pipeline/run.py seed",
    "hymns:publish": "python apps/hymns-pipeline/run.py publish",
    "hymns:check": "python apps/hymns-pipeline/run.py check",
    "hymns:test": "python -m unittest discover -s apps/hymns-pipeline/tests -v",
    "contracts:check": "corepack pnpm --filter @hinario/hymns-contracts check"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
